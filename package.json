{
  "name": "vite-plugin-refresh-guard",
  "version": "0.2.2",
  "$schema": "https://raw.githubusercontent.com/vitejs/vite-plugin-registry/refs/heads/main/data/schema/extended-package-json.schema.json",
  "description": "Vite plugin for web update notification — detect a new version on every page load and prompt users to reload: silent auto reload, force refresh, toast prompt, or blocking modal. Framework-agnostic core with Vue and React adapters. Vite 应用版本更新检测与自动刷新方案。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webkubor/vite-plugin-refresh-guard.git"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "web-update-notification",
    "update-notification",
    "new-version",
    "version-check",
    "app-update",
    "auto-reload",
    "auto-refresh",
    "force-refresh",
    "refresh",
    "service-worker",
    "pwa",
    "changelog",
    "vue",
    "react",
    "更新提示"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts"
    },
    "./vue": {
      "types": "./dist/vue/useVersionCheck.d.ts",
      "import": "./dist/vue/useVersionCheck.js"
    },
    "./vue/UpdatePrompt.vue": "./dist/vue/UpdatePrompt.vue",
    "./react": {
      "types": "./dist/react/useVersionCheck.d.ts",
      "import": "./dist/react/useVersionCheck.js"
    },
    "./react/UpdatePrompt": {
      "types": "./dist/react/UpdatePrompt.d.ts",
      "import": "./dist/react/UpdatePrompt.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/vue/useVersionCheck.ts src/react/useVersionCheck.ts src/react/UpdatePrompt.tsx --format esm --clean && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "compat": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run build && node scripts/prepublish-gate.mjs && node scripts/readme-gate.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vite": ">=4 <10",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "compatiblePackages": {
    "schemaVersion": 1,
    "vite": {
      "type": "compatible",
      "versions": ">=4 <10",
      "note": "Vite 6-8 走 per-environment hotUpdate，Vite 4-5 兜底 handleHotUpdate；两个钩子都实现了。"
    },
    "rollup": {
      "type": "incompatible",
      "reason": "Vite-only：版本号与项目根在 Vite 的 config / configResolved 钩子里解析，Rollup 不调用这两个钩子，虚拟模块 virtual:refresh-guard-changelog 的 load 会直接抛错。"
    },
    "rolldown": {
      "type": "incompatible",
      "reason": "Vite-only：本插件不是 Rolldown 插件，依赖 Vite 的配置钩子与 dev server 的 HMR 生命周期。"
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.41"
  },
  "engines": {
    "node": ">=20.19"
  }
}
