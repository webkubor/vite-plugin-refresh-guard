{
  "name": "vite-plugin-refresh-guard",
  "version": "0.2.0",
  "description": "Vite 应用的可配置版本更新检测+刷新方案：静默自动刷新 / 提示后自动刷新 / 弹窗阻断，按产品需要选档位，核心逻辑框架无关，附 Vue/React 适配层。Configurable new-version detection + refresh for Vite apps — silent / toast-auto / modal-blocking, framework-agnostic core with Vue and React adapters.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webkubor/vite-plugin-refresh-guard.git"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "version-check",
    "app-update",
    "service-worker",
    "pwa",
    "refresh",
    "changelog",
    "vue",
    "react"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts"
    },
    "./vue": {
      "types": "./dist/vue/useVersionCheck.d.ts",
      "import": "./dist/vue/useVersionCheck.js"
    },
    "./vue/UpdatePrompt.vue": "./dist/vue/UpdatePrompt.vue",
    "./react": {
      "types": "./dist/react/useVersionCheck.d.ts",
      "import": "./dist/react/useVersionCheck.js"
    },
    "./react/UpdatePrompt": {
      "types": "./dist/react/UpdatePrompt.d.ts",
      "import": "./dist/react/UpdatePrompt.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/vue/useVersionCheck.ts src/react/useVersionCheck.ts src/react/UpdatePrompt.tsx --format esm --clean && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "compat": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vite": ">=4 <10",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.41"
  },
  "engines": {
    "node": ">=20.19"
  }
}
